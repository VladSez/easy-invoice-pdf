# run `cp .env.example .env.local`

# for server side
SENTRY_ENABLED="false"
# for client side
NEXT_PUBLIC_SENTRY_ENABLED="false"

NEXT_PUBLIC_SENTRY_DSN=""

# Send Invoice feature. Whether it is on is decided by the "send-invoice" flag
# in the Vercel dashboard, not here. Locally there is no dashboard to read, so
# set this to "true" to work on the feature; it is ignored on deployments.
SEND_INVOICE_DEV="false"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

CLERK_SECRET_KEY=""
# Optional: avoids a Clerk JWKS network request for each cold start.
CLERK_JWT_KEY=""

# A Clerk user the OAuth e2e tests sign in as. The account must already exist
# in the development instance the keys above point at; the tests sign in with a
# backend-issued token, so it needs no password. Leave it empty and the
# signed-in half of `e2e/oauth.test.ts` skips itself.
E2E_CLERK_USER_EMAIL=""


# Resend (For emails) Create account and paste API keys in .env.local 
RESEND_API_KEY=""

# Upstash Redis (API rate limiting, including the Send invoice routes, and the Telegram queue)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Used for /api
AUTH_TOKEN=""

# Personal Info for sending invoice automatically, check /api/generate-invoice

# Sellet Info
SELLER_NAME="Adam Smith"
SELLER_ADDRESS="London, UK"
SELLER_VAT_NO="12345"
SELLER_EMAIL="seller@mail.com"
SELLER_ACCOUNT_NUMBER="12345"
SELLER_SWIFT_BIC="12345"

# Buyer Information
BUYER_NAME="Random Company"
BUYER_ADDRESS="Bristol, UK"
BUYER_VAT_NO="12345"
BUYER_EMAIL="buyer@mail.com"

INVOICE_NET_PRICE="10000"
INVOICE_EMAIL_RECIPIENT="seller@mail.com"
INVOICE_EMAIL_COMPANY_TO="buyer@mail.com"

# Telegram notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Google drive api
GOOGLE_DRIVE_CLIENT_EMAIL="example@mail.com"
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_PARENT_FOLDER_ID=""
